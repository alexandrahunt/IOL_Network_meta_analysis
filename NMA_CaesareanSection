data_raw <- read_excel(file_path, sheet = "Caesarean section") #Change sheet to assign outcome 

data_raw <- data_raw %>%
  mutate(study_clean = str_to_lower(Study) %>%
           str_replace_all("[^a-z0-9]", ""))

#match with low risk - flag low risk studies to later filter
lowROB_studies_flag <- lowROB_studies %>%
  mutate(lowROB = 1)

data_raw_low <- data_raw %>%
  left_join(lowROB_studies_flag %>% select(study_clean, lowROB),
            by = "study_clean") %>%
  mutate(lowROB = ifelse(is.na(lowROB), 0, 1))

