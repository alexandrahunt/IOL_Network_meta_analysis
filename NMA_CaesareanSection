data_raw_low$`Intervention in Arm 1` <- as.factor(data_raw_low$`Intervention in Arm 1`)
data_raw_low$`Intervention in Arm 2` <- as.factor(data_raw_low$`Intervention in Arm 2`)
data_raw_low$`Intervention in Arm 3` <- as.factor(data_raw_low$`Intervention in Arm 3`)
data_raw_low$`Total number in arm 1` <- as.numeric(data_raw_low$`Total number in arm 1`)
data_raw_low$`Total number in arm 2` <- as.numeric(data_raw_low$`Total number in arm 2`)
data_raw_low$`Total number in arm 3` <- as.numeric(data_raw_low$`Total number in arm 3`)

#Clean #####

##--- Convert from wide (two-arm) to long (one arm per row) --- ####
data_long_low <- data_raw_low %>%
  select(Study,
         Outcome = `Outcome of interest`,
         treat1 = `Intervention in Arm 1`,
         treat2 = `Intervention in Arm 2`,
         treat3 = `Intervention in Arm 3`,
         e1 = `Events in arm 1`,
         n1 = `Total number in arm 1`,
         e2 = `Events in arm 2`,
         n2 = `Total number in arm 2`,
         e3 = `Events in arm 3`,
         n3 = `Total number in arm 3`) %>%
  pivot_longer(
    cols = c(treat1, treat2, treat3, e1, e2, e3, n1, n2, n3),
    names_to = c(".value", "arm"),
    names_pattern = "([A-Za-z]+)([123])"
  ) %>%
  rename(treatment = treat, responders = e, sampleSize = n) %>%
  filter(!is.na(treatment)) %>%   # drop missing arms %>% 
  select(study = Study, treatment, responders, sampleSize)

head(data_long_low)
#clean treatment names. (no "" or +)
data_long_low <- data_long_low %>%
  mutate(
    treatment = treatment |> 
      str_replace_all("[\\u00A0\\t\\r\\n]", " ") |>  # replace non-breaking spaces, tabs, etc. with normal space
      str_trim() |>                                 # trim from both ends
      str_replace_all(fixed("+"), "_plus") |>       # replace plus with _plus
      str_replace_all("[^A-Za-z0-9_]", "_") |>      # replace remaining invalid characters
      str_replace_all("_+", "_") |>                 # collapse multiple underscores
      str_remove("^_") |>                           # remove leading underscore
      str_remove("_$")                              # remove trailing underscore
  )
