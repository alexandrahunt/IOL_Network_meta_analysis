#Order 
re_sum_OR <- re_sum_OR[order(re_sum_OR$`50%`),  ]
rownames(re_sum_OR) <- NULL
intervention_order <- unique(re_sum_OR$Treatment)
re_sum_OR$Intervention <- factor(re_sum_OR$Treatment, levels = rev(intervention_order))

# Check nothing failed to match (should return 0 rows)
re_sum_OR[is.na(re_sum_OR$Treatment), ]

# Text labels now show OR (95% CrI) instead of log-OR
re_sum_OR$label <- sprintf("%.2f (%.2f, %.2f)",
                           re_sum_OR$`50%`,
                           re_sum_OR$`2.5%`,
                           re_sum_OR$`97.5%`);re_sum_OR

p2 <- ggplot(re_sum_OR, aes(y = Intervention)) +
  geom_text(aes(x = 0, label = label), hjust = 0, size = 3.2) +
  scale_x_continuous(limits = c(0, 1)) +
  theme_void() +
  theme(
    plot.margin = margin(0, 40, 5.5, 5.5),
    plot.title = element_text(hjust = 0.05, size = 10, margin = margin(t = -2, b = 2))
  )+
  labs(title = "OR (95% CI)"); p2

# Forest plot on the odds ratio scale
p1 <- ggplot(re_sum_OR, aes(x = `50%`, y = Intervention)) +
  geom_point(size = 2) +
  geom_errorbarh(
    aes(xmin = `2.5%`, xmax = `97.5%`),
    height = 0.2
  ) +
  geom_vline(
    xintercept = 1,          # null effect on OR scale is 1, not 0
    linetype = "dashed",
    colour = "grey40"
  ) +
  scale_x_log10(
    breaks = c(0.00001, 0.0001, 0.001, 0.01, 0.1, 1, 10, 100, 1000, 5000, 20000),
    labels = c("0.00001","0.0001","0.001", "0.01", "0.1", "1", "10", "100", "1000", "5000", "20000"),
    oob = scales::oob_squish
  ) +          # log scale keeps CIs visually symmetric for ORs
  labs(
    x = "Odds ratio",
    y = "Intervention",
    title = "Network meta-analysis: Caesarean Section:\n Treatment effects vs Vaginal misoprostol (<50 micrograms)",
    subtitle = "Points show posterior median OR; lines show 95% credible intervals"
  ) +
  theme_bw(base_size = 12)+
  theme(
    plot.title = element_text(hjust = 0.5),
    plot.subtitle = element_text(hjust = 0.5)
  ); p1

