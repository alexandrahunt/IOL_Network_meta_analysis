png(save_path, width = 2500, height = 1500, res = 100)
print(plot(nma_data, 
     weight_nodes = TRUE, 
     weight_edges = TRUE, 
     nudge = 0.10))
dev.off()

#random effects nma model - uses the connected components (consistency model) (Set priors - informative)
icl_fit_re <- nma(nma_data, 
                  trt_effects = "random",
                  prior_intercept = normal(0,10),
                  prior_trt = normal(scale = 5),
                  prior_het = half_normal(scale = 1),
                  chains = 2,      # number of Markov chains
                  iter = 10000,     # total iterations per chain
                  warmup = 1000,   # number of warmup (burn-in) iterations
                  thin = 5,        # thinning interval
                  control = list(max_treedepth = 15, adapt_delta = 0.95)
)


#estimates against a chosen reference
re_treat <- relative_effects(icl_fit_re, all_contrasts = FALSE) 

##################
LOR_array <- as.array(re_treat)
OR_array <- exp(LOR_array)
re_treat_OR <- summary(OR_array)

# Use the OR summary as your plotting data frame
re_sum_OR <- as.data.frame(re_treat_OR);re_sum_OR
write_xlsx(re_sum_OR, path = file.path("")
)

#strip the D[] before treatment parametes
re_sum_OR$Treatment <- gsub("^d\\[|\\]$", "", re_sum_OR$parameter)

#Add look up table for acronyms of interventions 
