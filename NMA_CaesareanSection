plot(test_low, weight_nodes = TRUE, weight_edges = TRUE, nudge = 0.15)   #, show_trt_class = TRUE 
sum(test_low$agd_arm$sampleSize, na.rm = TRUE) #number of studies, women 

class(test_low)

#check for connection - if disconnected can see which and extract connected network for analyses  
summary(test_low)
is_network_connected(test_low)



# Extract the igraph representation to see disconnections 
g <- igraph::as.igraph(test_low)
comp <- igraph::components(g)
# Number of disconnected subnetworks
comp$no
# Identify the largest connected component
largest_comp <- which.max(comp$csize)

# Get treatments in the largest connected component
keep_trts <- igraph::V(g)$name[comp$membership == largest_comp]

# Filter the original dataset to keep only studies with treatments in that component
nma_data_connected <- data_long_low %>%
  filter(treatment %in% keep_trts)

#nma 
nma_data <- set_agd_arm(nma_data_connected, 
                        study = study, trt = treatment, 
                        r = responders, 
                        n = sampleSize, trt_ref = "Vaginal misoprostol (<50 micrograms)");nma_data

plot(nma_data, weight_nodes = TRUE, weight_edges = TRUE, nudge = 0.15)
